+/// Puts `item` into `list` (`on`) or takes it out; true when the list changed.
+fn set_member(list: &mut Vec<String>, item: &str, on: bool) -> bool {
+    let had = list.iter().any(|x| x == item);
+    if on && !had {
+        list.push(item.to_string());
+    } else if !on && had {
+        list.retain(|x| x != item);
+    }
