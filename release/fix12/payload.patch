+        return Ok(Obj::new());
+    }
+    match serde_json::from_slice(body) {
+        Ok(serde_json::Value::Object(o)) => Ok(o),
+        Ok(_) => Err(fail(400, libc::EINVAL, "expected a JSON object")),
+        Err(e) => Err(fail(400, libc::EINVAL, format!("bad JSON: {e}"))),
