+//! Lifetime lock independent of the HTTP socket: rest mode may close a listener without
+//! terminating its process. Never unlink this file, because contenders must share one inode.
+use std::{fs::{File,OpenOptions},io::{self,Write},os::fd::AsRawFd,path::Path};
+
+pub fn acquire(path:&Path)->io::Result<File>{
+    if std::fs::symlink_metadata(path).is_ok_and(|m|!m.is_file()||m.file_type().is_symlink()) {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput,"instance lock is not a regular file"));
+    }
+    let mut file=OpenOptions::new().create(true).read(true).write(true).truncate(false).open(path)?;
+    if unsafe{libc::flock(file.as_raw_fd(),libc::LOCK_EX|libc::LOCK_NB)}!=0{return Err(io::Error::last_os_error());}
+    // PID is diagnostic only. The kernel-held lock, not stale text, decides ownership.
+    file.set_len(0)?;writeln!(file,"{}",std::process::id())?;
+    Ok(file)
+}
+
+#[cfg(test)]mod tests {use super::*;
