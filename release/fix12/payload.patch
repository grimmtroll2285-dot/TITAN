+        if let Some(path)=std::env::var_os("TITAN_TEST_INSTANCE_PATH") {
+            let result=acquire(Path::new(&path));
+            if std::env::var_os("TITAN_TEST_INSTANCE_HELD").is_some(){assert_eq!(result.unwrap_err().kind(),io::ErrorKind::WouldBlock);}else{assert!(result.is_ok());}
+        }
+    }
+    #[test]fn second_process_is_rejected_and_stale_pid_text_does_not_block_new_owner(){
+        let path=std::env::temp_dir().join(format!("titan-instance-{}.lock",std::process::id()));
+        std::fs::write(&path,"stale PID text").unwrap();let guard=acquire(&path).unwrap();
+        let run=|held|{let mut command=std::process::Command::new(std::env::current_exe().unwrap());command.args(["--exact","instance::tests::child_probe"]).env("TITAN_TEST_INSTANCE_PATH",&path);if held{command.env("TITAN_TEST_INSTANCE_HELD","1");}command.status().unwrap().success()};
+        assert!(run(true));drop(guard);assert!(run(false));std::fs::remove_file(path).unwrap();
+    }
+}
