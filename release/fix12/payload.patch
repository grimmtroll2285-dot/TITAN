+  if self.path=='/fixture/requests':
+   self.send_response(200);self.send_header('Content-Type','application/json');self.end_headers();self.wfile.write(json.dumps(requests).encode());return
+  super().do_GET()
+ def do_POST(self):
+  global rebuild_until
+  body=self.rfile.read(int(self.headers.get('Content-Length',0))).decode();requests.append({'path':self.path,'body':body})
